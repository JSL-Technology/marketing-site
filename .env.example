# ─────────────────────────────────────────────────────────────────────────────
# JSL Technology — Environment Variables Reference
# Copy this file to .env and fill in your values before starting the project.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── SMTP (outbound email) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM="JSL Technology Contact" <noreply@jsltechnology.com>

# ── Contact form ──────────────────────────────────────────────────────────────
CONTACT_RECEIVER_EMAIL=info@jsltechnology.com
# Email that receives hot-lead sales alerts (lead score ≥ 60)
SALES_ALERT_EMAIL=sales@jsltechnology.com

# ── reCAPTCHA Enterprise ──────────────────────────────────────────────────────
# Get from https://cloud.google.com/recaptcha-enterprise
RECAPTCHA_SITE_KEY=your_site_key_here
RECAPTCHA_SECRET_KEY=your_secret_key_here

# ── Brevo (Sendinblue) CRM / email lists ─────────────────────────────────────
# API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key
# List ID for general contact-form leads
BREVO_LIST_CONTACT_ID=1
# List ID for whitepaper / newsletter leads
BREVO_LIST_WHITEPAPER_ID=2
# List ID for enterprise / VIP automation
BREVO_LIST_ENTERPRISE_ID=3

# ── Analytics & Tracking ─────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID (G-XXXXXXXXXX)
GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Google Tag Manager Container ID (GTM-XXXXXXX)
GTM_CONTAINER_ID=GTM-XXXXXXX
# Microsoft Clarity project ID (https://clarity.microsoft.com)
CLARITY_PROJECT_ID=your_clarity_project_id
# Meta Pixel ID
META_PIXEL_ID=your_meta_pixel_id

# ── SEO & Indexing ────────────────────────────────────────────────────────────
# Canonical base URL (no trailing slash)
CANONICAL_BASE_URL=https://www.jsl.technology
# Comma-separated list of allowed host headers (prevents host-header injection)
CANONICAL_HOSTS=www.jsl.technology,jsl.technology
# Google Search Console HTML verification token (meta tag value)
GSC_VERIFICATION_TOKEN=your_gsc_token

# ── Integrations ─────────────────────────────────────────────────────────────
# Calendly scheduling URL
CALENDLY_URL=https://calendly.com/your-team/meeting

# ── Feature flags (optional, comma-separated) ─────────────────────────────────
# Example: "social_proof_toasts,ab_hero_v2"
FEATURE_FLAGS=

# ── Build metadata (auto-set by CI/CD, optional locally) ─────────────────────
BUILD_DATE=
